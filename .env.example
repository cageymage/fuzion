# Local dev defaults. `npm run dev` loads .env first, then falls back to this
# file for anything .env doesn't set, so a fresh clone works without copying.
SITE_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://fuzion:fuzion@localhost:5432/fuzion?sslmode=disable
ADDR=127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:5173

# Discord login. Credentials come from the guild's app at https://discord.com/developers/applications/1551029986117292143/information —
# copy its OAuth2 Client ID / Client Secret into .env (see README). The redirect
# URL below is already registered there. The placeholders let the API start; login fails at Discord until real values are set.
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URL=http://localhost:5173/api/auth/callback
DISCORD_RECRUITING_WEBHOOK_URL=replace-with-discord-recruiting-webhook-url
DISCORD_ANNOUNCEMENTS_WEBHOOK_URL=replace-with-discord-announcements-webhook-url

# Cloudflare Turnstile bot check on the application form. These are Cloudflare's
# documented always-pass test keys, so local dev works with no account. Real keys
# come from the Cloudflare dashboard > Turnstile. Leave the secret empty to skip the check.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Twitch app credentials for `cmd/sync twitch`; leave empty to skip the job
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret

# Server-side only, never expose to the frontend. Restrict the key to YouTube Data API v3.
YOUTUBE_API_KEY=replace-with-youtube-api-key
# Playlist ID from the list= param of the YouTube playlist URL. Must be Public or Unlisted.
YOUTUBE_PLAYLIST_ID=replace-with-youtube-playlist-id

# Blizzard roster sync (cmd/sync blizzard-roster). Off unless the flag is true.
SYNC_BLIZZARD_ROSTER_ENABLED=false
# From a client at develop.battle.net. Never commit real values.
BLIZZARD_CLIENT_ID=replace-with-blizzard-client-id
BLIZZARD_CLIENT_SECRET=replace-with-blizzard-client-secret
BLIZZARD_REGION=us
# Profile namespace for the game version, e.g. profile-us (retail) or
# profile-classic1x-us (Classic Era). Forever's value is not known yet.
# Defaults to profile-<region> when unset.
BLIZZARD_NAMESPACE=profile-us
# The guild's realm and name as Blizzard slugs: lowercase, spaces to hyphens.
GUILD_REALM_SLUG=replace-with-guild-realm-slug
GUILD_NAME_SLUG=replace-with-guild-name-slug

# Battle.net account linking (/dashboard). Uses the BLIZZARD_CLIENT_ID/SECRET above;
# the redirect URL must be registered on that Blizzard client. Leave empty to disable linking.
BATTLENET_REDIRECT_URL=http://localhost:5173/api/auth/battlenet/callback