# Local dev defaults. `npm run dev` loads .env first, then falls back to this
# file for anything .env doesn't set, so a fresh clone works without copying.
DATABASE_URL=postgres://fuzion:fuzion@localhost:5432/fuzion?sslmode=disable
ADDR=127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:5173

# Discord login. Create an application at https://discord.com/developers/applications,
# copy its OAuth2 Client ID / Client Secret into .env, and register the redirect
# URL below on the app. The placeholders let the API start; login fails at Discord until real values are set.
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URL=http://localhost:5173/api/auth/callback
